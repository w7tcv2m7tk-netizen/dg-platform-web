{
  "name": "dg-platform-web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --experimental-strip-types --import ./scripts/register-ts-resolver.mjs --test scripts/test-platform-authority.mjs scripts/test-growth-tenant-isolation.mjs scripts/test-middleware-public-routes.mjs scripts/test-cron-auth.mjs scripts/test-webhook-secrets.mjs scripts/test-stripe-billing-separation.mjs scripts/test-dreamscape-auth.mjs scripts/test-rea-reaxml.mjs scripts/test-legacy-wp-form-post.mjs scripts/test-public-website-form-fields.mjs scripts/test-guest-identity.mjs scripts/test-public-host-slugs.mjs scripts/test-native-website-health.mjs scripts/test-team-invite.mjs scripts/test-subscription-lifecycle.mjs",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:push": "dotenv -e .env.local -- prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:studio": "dotenv -e .env.local -- prisma studio --schema=packages/database/prisma/schema.prisma",
    "setup:stripe-webhook": "node scripts/setup-stripe-webhook.mjs",
    "commerce:smoke": "node scripts/commerce-smoke-test.mjs",
    "abr:smoke": "node scripts/abr-smoke.mjs",
    "capture:screenshots": "node scripts/capture-marketing-screenshots.mjs",
    "sync:dg-apps": "dotenv -e .env.local -- node scripts/sync-digitalgate-apps-pages.mjs",
    "sync:dg-growth": "dotenv -e .env.local -- node scripts/sync-digitalgate-growth-landings.mjs",
    "sync:dg-insights": "dotenv -e .env.local -- node scripts/sync-digitalgate-insights-pages.mjs",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@prisma/client": "^6.19.0",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/blob": "^0.27.0",
    "imapflow": "^1.7.6",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^17.7.0",
    "undici": "^5.29.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
