{
  "name": "dg-platform-web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --experimental-strip-types --test scripts/test-dreamscape-auth.mjs",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:push": "dotenv -e .env.local -- prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:studio": "dotenv -e .env.local -- prisma studio --schema=packages/database/prisma/schema.prisma",
    "setup:stripe-webhook": "node scripts/setup-stripe-webhook.mjs",
    "commerce:smoke": "node scripts/commerce-smoke-test.mjs",
    "abr:smoke": "node scripts/abr-smoke.mjs",
    "capture:screenshots": "node scripts/capture-marketing-screenshots.mjs",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@prisma/client": "^6.19.0",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/blob": "^0.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^17.7.0",
    "undici": "^5.29.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
