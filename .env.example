# ─── Local development (.env.local) ───
# Use TEST keys (pk_test_ / sk_test_) — production keys reject localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — Dashboard → API Keys → Development (not Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# ─── Production (Vercel only) ───
# NEXT_PUBLIC_APP_URL=https://app.digitalgate.com.au
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# Auth routes (must match app paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# Production PWA: proxy Clerk Frontend API through the app origin so session
# handshake stays inside the installed standalone window (not clerk.*).
# ONLY set this AFTER Clerk Dashboard proxy validates successfully.
# Wrong order → host_invalid → SignIn shows no email/password.
# 1) Deploy app  2) Dashboard → Domains → Frontend API → Set proxy
#    → https://app.digitalgate.com.au/__clerk  3) set this env  4) redeploy
# NEXT_PUBLIC_CLERK_PROXY_URL=https://app.digitalgate.com.au/__clerk

# WordPress REST API (server-side only — no NEXT_PUBLIC prefix for keys)
DG_API_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1
DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# DigitalGate internal — org IDs that may open Command Centre (comma-separated UUIDs).
# Also granted for Clerk role dg:staff or DigitalGate org slug/name. See docs/COMMAND-CENTRE-BETA.md
# DG_COMMAND_CENTRE_ORG_IDS=

DG_API_KEY=

# Roe Realty WordPress (roerealty.com.au) — vendor lead sync; falls back to DG_API_KEY if unset
DG_WP_CONNECTOR_API_KEY=

# WordPress Connector — Roe vendor leads (Gen 1 → Gen 2 sync)
DG_WP_CONNECTOR_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1

# Website Health Centre — multiple WordPress sites (JSON array on Vercel, single line)
# DG_WP_HEALTH_SITES=[{"id":"roe","label":"Roe Realty","baseUrl":"https://roerealty.com.au/wp-json/digitalgate/v1"},{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]

# Accommodation — CVH hospitality (per-site apiKey required; Roe/DigitalGate keys will be rejected)
# DG_WP_ACCOMMODATION_API_KEY=dgdev_...   # optional shorthand for CVH only; also accepts WP stay dual-write webhook
# DG_WP_ACCOMMODATION_SITES=[{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]
# DG_ACC_ORGANISATION_ID=...              # pin StayBooking webhook → Neon org (else CVH brand/connector match)
# DG_STAY_BOOKING_WEBHOOK_SECRET=...      # optional shared secret for /api/webhooks/dg-stay-booking

# Platform database (Neon / Supabase) — Platform 1.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Brand / listing / avatar uploads (required on Vercel — Storage → Blob → BLOB_READ_WRITE_TOKEN)
# Locally optional: falls back to public/org-assets when unset
BLOB_READ_WRITE_TOKEN=

# Clerk webhook — Dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional — Google Geocoding API for auto address finder (recommended for Roe)
# Enable Geocoding API in Google Cloud; falls back to OpenStreetMap when unset
GOOGLE_GEOCODING_API_KEY=
# Business Discovery — Places Text Search (New). Prefer a dedicated key; falls back to GOOGLE_GEOCODING_API_KEY if Places is enabled on it.
# GOOGLE_PLACES_API_KEY=
# ABR / ABN Lookup authentication GUID (server-only secret — NEVER NEXT_PUBLIC_*)
# Register at https://abr.business.gov.au/Tools/WebServices — paste GUID into .env.local only
# Accepted names (first present wins): ABN_LOOKUP_GUID | ABR_GUID | ABR_AUTHENTICATION_GUID
# ABN_LOOKUP_GUID=
# ABR_GUID=
# ABR_AUTHENTICATION_GUID=

# Commerce — Stripe (test keys locally; live keys on Vercel)
# Webhook URL: https://app.digitalgate.com.au/api/webhooks/stripe
# Must listen for:
#   checkout.session.completed (+ async_payment_succeeded)
#   invoice.paid (Refer & Earn months 2–12)
#   customer.subscription.deleted / customer.subscription.updated (platform seat lifecycle)
#   Connect: account.updated / transfer.failed / transfer.reversed
# Register or update events:
#   STRIPE_SECRET_KEY=sk_… node scripts/setup-stripe-webhook.mjs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key for future embedded checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional Dashboard Price IDs for platform SaaS Checkout (AUD monthly).
# When unset, checkout falls back to inline price_data (still works for dogfood).
# Create Products/Prices in Stripe Dashboard → copy price_… ids here.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...   # alias: STRIPE_PRICE_GROWTH
# STRIPE_PRICE_BUSINESS=price_...       # alias: STRIPE_PRICE_SCALE
# Refer & Earn cash payouts — Stripe Connect Express (AU). Opt-in; without this,
# Settings → Refer & Earn keeps platform credit as default and shows a clear
# "bank payouts not enabled" state (no stub ledger debits).
# Enable Connect on the same Stripe account as STRIPE_SECRET_KEY (Express).
# Platform must hold balance to fund transfers. Re-run webhook setup for
# account.updated / transfer.failed / transfer.reversed.
# STRIPE_CONNECT_ENABLED=true

# Public onboarding URL (used in client components after signup)
NEXT_PUBLIC_DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# Optional — transactional email (Refer & Earn invites, branded outbound)
# Also required for Infrastructure → Email E1 (Prepare sending domain / auth DNS)
# RESEND_API_KEY=re_...
# Platform fallback From only. Tenant sends resolve per brand (DG / RR / CVH / …).
# RESEND_FROM_EMAIL=DigitalGate <hello@mail.digitalgate.com.au>

# Live support chat (Gen 2 — stored in Neon; Assist auto-reply when LLM keys exist)
# DG_SUPPORT_ADMIN_EMAIL=support@digitalgate.com.au
# DG_SUPPORT_AI_AUTO_REPLY=1

# AI Communications — voice provider (server-side only, never in the browser or org records)
# See docs/ai/VOICE-AGENT-RUNBOOK.md
# ELEVENLABS_API_KEY=
# ELEVENLABS_WEBHOOK_SECRET=
# Optional shared secret for agent tool webhooks (falls back to ELEVENLABS_API_KEY)
# ELEVENLABS_TOOL_SECRET=
# Post-call webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/elevenlabs
# Tool webhooks (auto on publish): {NEXT_PUBLIC_APP_URL}/api/webhooks/elevenlabs/tools?agentId=…&tool=…
# Business Audit admin notifications (defaults hello@digitalgate.com.au):
# DG_BUSINESS_AUDIT_ADMIN_EMAIL=hello@digitalgate.com.au
# Cron routes (/api/cron/*) — required outside Vercel cron header:
# CRON_SECRET=
# Optional DMARC default for Apply auth DNS:
# DG_EMAIL_DMARC_POLICY=v=DMARC1; p=none; rua=mailto:dmarc@digitalgate.com.au

# Infrastructure — Dreamscape is a strong V1 foundation
# NEVER commit real keys. Docs/example hashes from Dreamscape are not ours.
# If a real key was pasted into chat/git: regenerate in Reseller Console.
# Never paste API keys into chat again. Browser → DigitalGate API only.
#
# TWO APIs — do not mix auth:
#   SOAP (SecureAPI) = Reseller ID + API Key in Authenticate SOAP header
#     → what “API & WHMCS → API Setup” Reseller ID is for (support/WHMCS)
#     Sandbox: https://soap-test.secureapi.com.au/API-1.3
#     Prod:    https://soap.secureapi.com.au/API-1.3
#     WSDL:    https://soap.secureapi.com.au/wsdl/API-1.3.wsdl
#     Method:  DomainCheck
#     NOTE: WSDL also lists …/server.php?v=1.3 — that path returns HTTP 200
#           with an EMPTY body on both hosts. Always use /API-1.3.
#   REST (doc-reseller-api) = Api-Request-Id + Api-Signature (NO Reseller ID)
#     Sandbox: https://reseller-api.sandbox.ds.network
#     Prod:    https://reseller-api.ds.network
#     Docs:    https://doc-reseller-api.ds.network/
#
# Mode: DREAMSCAPE_API_MODE=soap|rest
#   unset + DREAMSCAPE_RESELLER_ID set → soap
#   unset + no Reseller ID → rest
#
# SOAP env (critical — match the console you copied credentials from):
#   Live API Setup (reseller.ds.network)     → DREAMSCAPE_SOAP_ENV=production
#                                              → https://soap.secureapi.com.au/API-1.3
#   Sandbox console (reseller.sandbox…)      → DREAMSCAPE_SOAP_ENV=sandbox (default)
#                                              → https://soap-test.secureapi.com.au/API-1.3
#   Alias: DREAMSCAPE_ENV=sandbox|production
#   Full URL override: DREAMSCAPE_SOAP_ENDPOINT or DREAMSCAPE_SOAP_URL
#   (server.php overrides are auto-rewritten to /API-1.3)
#
# Sandbox key: https://reseller.sandbox.ds.network → API & WHMCS → API Setup
# Live key:    https://reseller.ds.network (same path)
# Key must be 32 lowercase alphanumeric chars — no spaces or wrapping quotes.
# Redeploy after env changes. Server-only — do NOT use NEXT_PUBLIC_.
#
# --- SOAP live (Reseller ID from live API Setup, e.g. 25735) ---
# DREAMSCAPE_RESELLER_ID=25735
# DREAMSCAPE_API_KEY=
# DREAMSCAPE_API_MODE=soap
# DREAMSCAPE_SOAP_ENV=production
#
# --- SOAP sandbox ---
# DREAMSCAPE_RESELLER_ID=
# DREAMSCAPE_API_KEY=
# DREAMSCAPE_API_MODE=soap
# DREAMSCAPE_SOAP_ENV=sandbox
# Optional full URL override:
# DREAMSCAPE_SOAP_ENDPOINT=https://soap-test.secureapi.com.au/API-1.3
# DREAMSCAPE_SOAP_URL=https://soap.secureapi.com.au/API-1.3
#
# --- REST alternative ---
# DREAMSCAPE_API_MODE=rest
# DREAMSCAPE_API_KEY=
# DREAMSCAPE_API_BASE_URL=https://reseller-api.sandbox.ds.network
# Optional REST-only experiment (NOT official REST auth):
#   DREAMSCAPE_SEND_RESELLER_ID=true
#   DREAMSCAPE_RESELLER_ID_HEADER=X-Reseller-Id
#
# Optional HTTPS proxy (mainly production):
# DREAMSCAPE_HTTPS_PROXY=http://user:password@fixie.example.com:80
# HTTPS_PROXY=http://user:password@fixie.example.com:80
#
# Domain transfer Notification URL (Reseller Console → API & WHMCS / notifications).
# Paste production URL (append ?secret=… — Dreamscape docs do not define a webhook signature):
#   https://app.digitalgate.com.au/api/webhooks/dreamscape?secret=<DREAMSCAPE_WEBHOOK_SECRET>
# Generate a random secret (do NOT reuse DREAMSCAPE_API_KEY).
# If a webhook secret was ever pasted into chat: rotate DREAMSCAPE_WEBHOOK_SECRET
# and update the Notification URL in Reseller Console.
# DREAMSCAPE_WEBHOOK_SECRET=

# Paid domain registration safety (SOAP DomainCreate / REST register):
# Org feature flag infra.domain_register must be true (Command Centre → Flags).
# UI requires typed domain confirm; production also needs confirmProduction.
# Global kill-switch (optional):
# DG_DOMAIN_REGISTER_ENABLED=0

# Website hosting DNS (Make it live / Apply website DNS):
# Preferred: set VERCEL_* so Apply uses project recommended A/CNAME + attaches apex+www.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Optional hard overrides (when BOTH set, skip Vercel recommendations):
# DG_WEBSITE_DNS_A_TARGET=216.198.79.1
# DG_WEBSITE_DNS_CNAME_TARGET=xxxx.vercel-dns-017.com
# Soft-on Website Builder (unset = on):
# DG_WEBSITES_BUILDER=1

# Cloudflare — edge cache purge + zone status (Infrastructure → Cloudflare)
# Create API token: Zone · Cache Purge · Zone Read · Analytics Read
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# Aliases: CF_API_TOKEN, CF_ZONE_ID, CF_ACCOUNT_ID

# —— Domain.com.au (Property Syndication / Listings Management) ——
# OAuth client from https://developer.domain.com.au (Credentials).
# Listing Management clients use Grant Type = Authorization Code (not client_credentials).
# Redirect must match exactly:
#   https://app.digitalgate.com.au/api/connectors/domain/callback
DOMAIN_CLIENT_ID=client_f48daf280a11b1129383f02420e492ef
DOMAIN_CLIENT_SECRET=
# DOMAIN_REDIRECT_URI=https://app.digitalgate.com.au/api/connectors/domain/callback
# Sandbox Listing Management paths: /sandbox/v1/… (omit for Primary / production)
# DOMAIN_API_PATH_PREFIX=/sandbox
# Optional scope overrides (space-separated):
# DOMAIN_OAUTH_SCOPES=api_agencies_read api_listings_read
# DOMAIN_AUTH_CODE_SCOPES=openid profile offline_access api_listings_read api_listings_write api_agencies_read api_agencies_write

# —— realestate.com.au / REA Group (Partner Platform Listing Upload) ——
# Auth = OAuth2 client_credentials (NOT Authorization Code like Domain).
# Docs: https://partner.realestate.com.au/getting-started/authentication/
# Upload: POST /listing/v1/upload (REAXML). Agency activate via Ignite / Change of Uploader.
# See docs/connectors/REA.md — never commit secrets.
# REA_CLIENT_ID=
# REA_CLIENT_SECRET=
# REA_API_BASE_URL=https://api.realestate.com.au
# REA_AUTH_TOKEN_URL=https://api.realestate.com.au/oauth/token
# Optional — usually omit (scopes come from agency grants):
# REA_OAUTH_SCOPES=

# —— Cotality / CoreLogic Asia (RP Data) — Property data connector ——
# Developer portal: https://developer.corelogic.asia
# OAuth2 client credentials (sandbox). NEVER commit CLIENT_SECRET.
# Docs: docs/connectors/COTALITY-CORELOGIC.md
# CORELOGIC_CLIENT_ID=
# CORELOGIC_CLIENT_SECRET=
# CORELOGIC_TOKEN_URL=https://api-sbox.corelogic.asia/access/as/token.oauth2
# CORELOGIC_SEARCH_BASE=https://api-sbox.corelogic.asia/search
# Optional alias if Search and other APIs share one host override:
# CORELOGIC_API_BASE=https://api-sbox.corelogic.asia/search
# CORELOGIC_CLIENT_NAME=digitalgate-property-data
# CORELOGIC_MATCH_PROFILE_ID=1
# Property Details + AVM (defaults are sandbox):
# CORELOGIC_PROPERTY_DETAILS_BASE=https://api-sbox.corelogic.asia/property-details
# CORELOGIC_AVM_BASE=https://api-sbox.corelogic.asia/avm

# —— Google Business Profile (Connector Engine · Business) ——
# OAuth client from Google Cloud Console. Enable Business Profile APIs.
# Redirect must match exactly:
#   https://app.digitalgate.com.au/api/connectors/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://app.digitalgate.com.au/api/connectors/google/callback
# Optional scope override (space-separated):
# GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/business.manage

# —— LinkedIn (Social App · company page publishing) ——
# LinkedIn Developers → My apps → DigitalGate → Auth
# Redirect must match exactly:
#   https://app.digitalgate.com.au/api/connectors/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://app.digitalgate.com.au/api/connectors/linkedin/callback
# If Community Management is still pending, start with OpenID only:
# LINKEDIN_OAUTH_SCOPES=openid profile email

# Optional — AI Assist (/api/v1/ai/assist). Without a key, template drafts are returned.
# Model Router transports: Vercel AI Gateway (preferred when keyed), then Anthropic, then OpenAI.
# Gateway is billed by Vercel — do not send OPENAI_API_KEY to Gateway (that is BYOK / misses Sol promo).
# AI_GATEWAY_API_KEY=...
# On Vercel deployments, VERCEL_OIDC_TOKEN is enough if OIDC is enabled.
# DG_LLM_GATEWAY_MODEL=openai/gpt-5.4-mini
# DG_LLM_GATEWAY_REASONING_MODEL=openai/gpt-5.6-sol
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DG_LLM_PROVIDER=gateway

# —— Observability (Sentry floor) ——
# Error capture for ops — not a customer uptime / monitoring product.
# Leave unset for no-op (app must not crash). Client needs the NEXT_PUBLIC_ value.
# SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
