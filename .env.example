# ─── Local development (.env.local) ───
# Use TEST keys (pk_test_ / sk_test_) — production keys reject localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — Dashboard → API Keys → Development (not Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# ─── Production (Vercel only) ───
# NEXT_PUBLIC_APP_URL=https://app.digitalgate.com.au
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# Auth routes (must match app paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# Production PWA: proxy Clerk Frontend API through the app origin so session
# handshake stays inside the installed standalone window (not clerk.*).
# ONLY set this AFTER Clerk Dashboard proxy validates successfully.
# Wrong order → host_invalid → SignIn shows no email/password.
# 1) Deploy app  2) Dashboard → Domains → Frontend API → Set proxy
#    → https://app.digitalgate.com.au/__clerk  3) set this env  4) redeploy
# NEXT_PUBLIC_CLERK_PROXY_URL=https://app.digitalgate.com.au/__clerk

# WordPress REST API (server-side only — no NEXT_PUBLIC prefix for keys)
DG_API_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1
DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# DigitalGate internal — org IDs that see Command Centre in the sidebar (comma-separated)
# DG_COMMAND_CENTRE_ORG_IDS=

DG_API_KEY=

# Roe Realty WordPress (roerealty.com.au) — vendor lead sync; falls back to DG_API_KEY if unset
DG_WP_CONNECTOR_API_KEY=

# WordPress Connector — Roe vendor leads (Gen 1 → Gen 2 sync)
DG_WP_CONNECTOR_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1

# Website Health Centre — multiple WordPress sites (JSON array on Vercel, single line)
# DG_WP_HEALTH_SITES=[{"id":"roe","label":"Roe Realty","baseUrl":"https://roerealty.com.au/wp-json/digitalgate/v1"},{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]

# Accommodation — CVH hospitality (per-site apiKey required; Roe/DigitalGate keys will be rejected)
# DG_WP_ACCOMMODATION_API_KEY=dgdev_...   # optional shorthand for CVH only; also accepts WP stay dual-write webhook
# DG_WP_ACCOMMODATION_SITES=[{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]
# DG_ACC_ORGANISATION_ID=...              # pin StayBooking webhook → Neon org (else CVH brand/connector match)
# DG_STAY_BOOKING_WEBHOOK_SECRET=...      # optional shared secret for /api/webhooks/dg-stay-booking

# Platform database (Neon / Supabase) — Platform 1.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Brand / listing / avatar uploads (required on Vercel — Storage → Blob → BLOB_READ_WRITE_TOKEN)
# Locally optional: falls back to public/org-assets when unset
BLOB_READ_WRITE_TOKEN=

# Clerk webhook — Dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional — Google Geocoding API for auto address finder (recommended for Roe)
# Enable Geocoding API in Google Cloud; falls back to OpenStreetMap when unset
GOOGLE_GEOCODING_API_KEY=

# Commerce — Stripe (test keys locally; live keys on Vercel)
# Webhook URL: https://app.digitalgate.com.au/api/webhooks/stripe
# Must listen for invoice.paid (Refer & Earn months 2–12) + Connect events — run:
#   STRIPE_SECRET_KEY=sk_… node scripts/setup-stripe-webhook.mjs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key for future embedded checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Refer & Earn cash payouts — Stripe Connect Express (AU). Opt-in; without this,
# Settings → Refer & Earn keeps platform credit as default and shows a clear
# "bank payouts not enabled" state (no stub ledger debits).
# Enable Connect on the same Stripe account as STRIPE_SECRET_KEY (Express).
# Platform must hold balance to fund transfers. Re-run webhook setup for
# account.updated / transfer.failed / transfer.reversed.
# STRIPE_CONNECT_ENABLED=true

# Public onboarding URL (used in client components after signup)
NEXT_PUBLIC_DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# Optional — transactional email (Refer & Earn invites, branded outbound)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=DigitalGate <noreply@digitalgate.com.au>

# Infrastructure — Dreamscape is a strong V1 foundation
# NEVER commit real keys. Docs/example hashes from Dreamscape are not ours.
# If a real key was pasted into chat/git: regenerate in Reseller Console.
# Browser → DigitalGate API only; key stays server-side.
#
# IMPORTANT: Sandbox and production API keys can DIFFER.
# A production key will 401 against https://reseller-api.sandbox.ds.network
# (and vice versa). Copy the key from the console that matches the base URL.
#
# Sandbox key: https://reseller.sandbox.ds.network
#   → Account Settings → API & WHMCS → API Setup
# Live key:    https://reseller.ds.network (same path)
# Docs: https://doc-reseller-api.ds.network/
#
# REST auth = Api-Request-Id + Api-Signature (md5(request_id + api_key) only).
# Reseller ID on the API Setup page is account/WHMCS identity — NOT a REST header.
# Do not set DREAMSCAPE_RESELLER_ID for this integration.
#
# IP whitelist (same API Setup page): Vercel egress IPs are dynamic unless you
# enable Static IPs (https://vercel.com/docs/networking/static-ips). For sandbox,
# leave whitelist empty/disabled if allowed; otherwise whitelist Static IPs or
# proxy via a fixed-egress host. Redeploy after env changes.
#
# Key must be 32 lowercase alphanumeric chars — no spaces or wrapping quotes.
# (Optional later: DREAMSCAPE_API_KEY_SANDBOX vs prod — for now one key.)
#
# DREAMSCAPE_API_KEY=
# Default / required for development — sandbox only until tests pass:
# DREAMSCAPE_API_BASE_URL=https://reseller-api.sandbox.ds.network
# Production (explicit only, after automated tests):
# DREAMSCAPE_API_BASE_URL=https://reseller-api.ds.network
#
# Domain transfer Notification URL (Reseller Console → API & WHMCS / notifications).
# Paste production URL (append ?secret=… — Dreamscape docs do not define a webhook signature):
#   https://app.digitalgate.com.au/api/webhooks/dreamscape?secret=<DREAMSCAPE_WEBHOOK_SECRET>
# Generate a random secret (do NOT reuse DREAMSCAPE_API_KEY):
# DREAMSCAPE_WEBHOOK_SECRET=

# Optional — AI Assist (/api/v1/ai/assist). Without a key, template drafts are returned.
# Prefer one provider; if both are set, Anthropic is used unless DG_LLM_PROVIDER overrides.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DG_LLM_PROVIDER=anthropic
