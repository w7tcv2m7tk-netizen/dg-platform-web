# ─── Local development (.env.local) ───
# Use TEST keys (pk_test_ / sk_test_) — production keys reject localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — Dashboard → API Keys → Development (not Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# ─── Production (Vercel only) ───
# NEXT_PUBLIC_APP_URL=https://app.digitalgate.com.au
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# Auth routes (must match app paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# WordPress REST API (server-side only — no NEXT_PUBLIC prefix for keys)
DG_API_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1
DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# DigitalGate internal — org IDs that see Command Centre in the sidebar (comma-separated)
# DG_COMMAND_CENTRE_ORG_IDS=

DG_API_KEY=

# Roe Realty WordPress (roerealty.com.au) — vendor lead sync; falls back to DG_API_KEY if unset
DG_WP_CONNECTOR_API_KEY=

# WordPress Connector — Roe vendor leads (Gen 1 → Gen 2 sync)
DG_WP_CONNECTOR_BASE_URL=https://digitalgate.com.au/wp-json/digitalgate/v1

# Website Health Centre — multiple WordPress sites (JSON array on Vercel, single line)
# DG_WP_HEALTH_SITES=[{"id":"roe","label":"Roe Realty","baseUrl":"https://roerealty.com.au/wp-json/digitalgate/v1"},{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]

# Accommodation — CVH hospitality (per-site apiKey required; Roe/DigitalGate keys will be rejected)
# DG_WP_ACCOMMODATION_API_KEY=dgdev_...   # optional shorthand for CVH only
# DG_WP_ACCOMMODATION_SITES=[{"id":"cvh","label":"Currumbin Valley Hideaway","baseUrl":"https://currumbinvalleyhideaway.com.au/wp-json/digitalgate/v1","apiKey":"dgdev_..."}]

# Platform database (Neon / Supabase) — Platform 1.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Brand / listing / avatar uploads (required on Vercel — Storage → Blob → BLOB_READ_WRITE_TOKEN)
# Locally optional: falls back to public/org-assets when unset
BLOB_READ_WRITE_TOKEN=

# Clerk webhook — Dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional — Google Geocoding API for auto address finder (recommended for Roe)
# Enable Geocoding API in Google Cloud; falls back to OpenStreetMap when unset
GOOGLE_GEOCODING_API_KEY=

# Commerce — Stripe (test keys locally; live keys on Vercel)
# Webhook URL: https://app.digitalgate.com.au/api/webhooks/stripe
# Must listen for invoice.paid (Refer & Earn months 2–12) — run:
#   STRIPE_SECRET_KEY=sk_… node scripts/setup-stripe-webhook.mjs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key for future embedded checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public onboarding URL (used in client components after signup)
NEXT_PUBLIC_DG_ONBOARDING_URL=https://digitalgate.com.au/onboarding/

# Optional — transactional email (Refer & Earn invites, branded outbound)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=DigitalGate <noreply@digitalgate.com.au>

# Optional — AI Assist (/api/v1/ai/assist). Without a key, template drafts are returned.
# Prefer one provider; if both are set, Anthropic is used unless DG_LLM_PROVIDER overrides.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DG_LLM_PROVIDER=anthropic
