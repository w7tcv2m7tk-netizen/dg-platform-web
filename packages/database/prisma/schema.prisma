// ─── Partner Programme ────────────────────────────────────────────────────────

/**
 * A qualified DigitalGate Partner — Founding Reseller, Founding Partner, etc.
 * Separate from the Refer & Earn PlatformReferral model (self-service customer credits).
 * Partners are human-curated; commissions are cash, not SaaS credits.
 */
model Partner {
  id                       String    @id @default(cuid())
  /** Clerk user ID for this partner's login */
  clerkUserId              String    @map("clerk_user_id")
  /** Optional link to a DigitalGate customer org (partner may also be a customer) */
  organisationId           String?   @map("organisation_id")
  /** FOUNDING_RESELLER | IMPLEMENTATION_PARTNER | TECHNOLOGY_PARTNER | STRATEGIC_PARTNER | … */
  partnerType              String    @map("partner_type")
  /** Programme cohort label e.g. "founding_10" */
  cohort                   String?
  /** Commission rate in basis points (3000 = 30%) */
  commissionBps            Int       @default(2000) @map("commission_bps")
  /** Number of months commission is payable per referred customer */
  commissionDurationMonths Int       @default(12) @map("commission_duration_months")
  /** active | pending | suspended | inactive */
  status                   String    @default("pending")
  /** Unique referral code — used in referral URLs /r/{code} */
  referralCode             String    @unique @map("referral_code")
  /** Partner's display name (cached from Clerk; refreshed on login) */
  displayName              String?   @map("display_name")
  email                    String?
  phone                    String?
  businessName             String?   @map("business_name")
  /** Delivery Partner division role: lead | member — only for IMPLEMENTATION_PARTNER */
  deliveryRole             String?   @map("delivery_role")
  notes                    String?   @db.Text
  joinedAt                 DateTime? @map("joined_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  referrals                PartnerReferral[]
  commissions              PartnerCommission[]
  ownedDeliveryProjects    DeliveryProject[] @relation("DeliveryProjectOwner")
  leadDeliveryProjects     DeliveryProject[] @relation("DeliveryProjectLead")
  assignedDeliveryTasks    DeliveryTask[]    @relation("DeliveryTaskAssignee")

  @@index([clerkUserId])
  @@index([status])
  @@index([referralCode])
  @@map("partners")
}

/**
 * A referral submitted by a Partner — either via link attribution or warm introduction.
 * Must NOT expose private customer data back to the partner.
 */
model PartnerReferral {
  id                      String    @id @default(cuid())
  partnerId               String    @map("partner_id")
  referralCode            String    @map("referral_code")
  /** Business being referred */
  businessName            String    @map("business_name")
  contactName             String?   @map("contact_name")
  email                   String?
  phone                   String?
  website                 String?
  industry                String?
  notes                   String?   @db.Text
  /** link | warm_introduction */
  source                  String    @default("link")
  /**
   * INVITED | REFERRED | CONTACTED | CONSULTATION | ACCEPTED
   * | ONBOARDING | ACTIVE | COMMISSIONING | CLOSED | DECLINED
   */
  status                  String    @default("REFERRED")
  /** Link to DigitalGate CRM contact when one was created */
  referredContactId       String?   @map("referred_contact_id")
  /** Link to converted customer org — set only when customer signed up */
  referredOrganisationId  String?   @map("referred_organisation_id")
  referredAt              DateTime  @default(now()) @map("referred_at")
  contactedAt             DateTime? @map("contacted_at")
  consultationAt          DateTime? @map("consultation_at")
  acceptedAt              DateTime? @map("accepted_at")
  convertedAt             DateTime? @map("converted_at")
  metadata                Json?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissions PartnerCommission[]

  @@index([partnerId, status])
  @@index([referralCode])
  @@index([email])
  @@index([referredOrganisationId])
  @@map("partner_referrals")
}

/**
 * Commission ledger entry for a Partner — one per billing period per referred customer.
 * Separate from PlatformReferralLedger (customer refer-a-friend credits).
 */
model PartnerCommission {
  id                      String    @id @default(cuid())
  partnerId               String    @map("partner_id")
  referralId              String    @map("referral_id")
  /** The DigitalGate organisation (customer) generating the qualifying revenue */
  customerOrganisationId  String?   @map("customer_organisation_id")
  /** Stripe subscription id if applicable */
  subscriptionId          String?   @map("subscription_id")
  commissionBps           Int       @map("commission_bps")
  qualifyingRevenueCents  Int       @map("qualifying_revenue_cents")
  commissionAmountCents   Int       @map("commission_amount_cents")
  currency                String    @default("AUD")
  periodStart             DateTime? @map("period_start")
  periodEnd               DateTime? @map("period_end")
  /** CALCULATED | PENDING | APPROVED | PAID */
  status                  String    @default("CALCULATED")
  approvedAt              DateTime? @map("approved_at")
  paidAt                  DateTime? @map("paid_at")
  notes                   String?
  metadata                Json?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  partner  Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral PartnerReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  events   PartnerCommissionEvent[]

  @@index([partnerId, status])
  @@index([referralId])
  @@index([customerOrganisationId])
  @@map("partner_commissions")
}

/**
 * Immutable audit trail for commission calculation events.
 * Handles payments, refunds, credits, cancellations, etc.
 */
model PartnerCommissionEvent {
  id               String   @id @default(cuid())
  partnerId        String   @map("partner_id")
  referralId       String   @map("referral_id")
  commissionId     String?  @map("commission_id")
  subscriptionId   String?  @map("subscription_id")
  /** Stripe invoice id when triggered by a payment */
  invoiceId        String?  @map("invoice_id")
  /**
   * invoice_paid | invoice_refunded | subscription_cancelled
   * | subscription_changed | credit_applied | manual_adjustment
   */
  eventType        String   @map("event_type")
  qualifyingAmountCents Int  @map("qualifying_amount_cents")
  commissionBps    Int      @map("commission_bps")
  commissionAmountCents Int  @map("commission_amount_cents")
  currency         String   @default("AUD")
  period           String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  commission PartnerCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([referralId])
  @@index([commissionId])
  @@index([invoiceId])
  @@map("partner_commission_events")
}

// ─── Delivery workspace ───────────────────────────────────────────────────────

/** Customer implementation record — one per onboarded customer. */
model DeliveryProject {
  id                     String    @id @default(cuid())
  referenceCode          String    @unique @map("reference_code")
  customerOrganisationId String    @map("customer_organisation_id")
  /** Current pipeline stage id — see DELIVERY_PIPELINE_STAGES */
  status                 String    @default("accepted")
  /** on_track | at_risk | blocked */
  health                 String    @default("on_track")
  /** launch | growth | enterprise */
  plan                   String    @default("launch")
  ownerPartnerId         String?   @map("owner_partner_id")
  deliveryLeadPartnerId  String?   @map("delivery_lead_partner_id")
  targetGoLiveAt         DateTime? @map("target_go_live_at")
  apps                   Json?
  nextAction             String?   @map("next_action") @db.Text
  nextActionDueAt        DateTime? @map("next_action_due_at")
  opportunityId          String?   @map("opportunity_id")
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  customerOrganisation Organisation @relation(fields: [customerOrganisationId], references: [id], onDelete: Cascade)
  ownerPartner         Partner?     @relation("DeliveryProjectOwner", fields: [ownerPartnerId], references: [id], onDelete: SetNull)
  deliveryLeadPartner  Partner?     @relation("DeliveryProjectLead", fields: [deliveryLeadPartnerId], references: [id], onDelete: SetNull)
  milestones           DeliveryMilestone[]
  tasks                DeliveryTask[]
  blockers             DeliveryBlocker[]

  @@index([customerOrganisationId])
  @@index([status])
  @@index([health])
  @@index([ownerPartnerId])
  @@index([deliveryLeadPartnerId])
  @@map("delivery_projects")
}

model DeliveryMilestone {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  stageId     String    @map("stage_id")
  title       String
  sortOrder   Int       @map("sort_order")
  /** pending | in_progress | complete | skipped */
  status      String    @default("pending")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("delivery_milestones")
}

model DeliveryTask {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  title             String
  description       String?   @db.Text
  /** pending | in_progress | complete | cancelled */
  status            String    @default("pending")
  dueAt             DateTime? @map("due_at")
  assigneePartnerId String?   @map("assignee_partner_id")
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project         DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneePartner Partner?        @relation("DeliveryTaskAssignee", fields: [assigneePartnerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneePartnerId, dueAt])
  @@map("delivery_tasks")
}

model DeliveryBlocker {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  description String    @db.Text
  /** open | resolved */
  status      String    @default("open")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project DeliveryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("delivery_blockers")
}

/** Property Management Industry App — rental properties. */
model PmProperty {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String
  addressLine1   String    @map("address_line1")
  suburb         String
  state          String    @default("QLD")
  postcode       String    @default("")
  country        String    @default("AU")
  status         String    @default("active")
  propertyType   String?   @map("property_type")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leases       PmLease[]
  maintenance  PmMaintenanceRequest[]

  @@index([organisationId, status])
  @@map("pm_properties")
}

/** Property Management Industry App — long-term residential leases. */
model PmLease {
  id                String    @id @default(cuid())
  organisationId    String    @map("organisation_id")
  propertyId        String?   @map("property_id")
  title             String
  addressLine1      String?   @map("address_line1")
  suburb            String?
  stage             String    @default("application")
  status            String    @default("active")
  ownerContactId    String?   @map("owner_contact_id")
  tenantContactId   String?   @map("tenant_contact_id")
  rentCents         Int?      @map("rent_cents")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  notes             String?
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  property      PmProperty?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownerContact  Contact?     @relation("PmOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  tenantContact Contact?     @relation("PmTenant", fields: [tenantContactId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, stage])
  @@index([organisationId, propertyId])
  @@map("pm_leases")
}

/** Property Management Industry App — maintenance requests. */
model PmMaintenanceRequest {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  propertyId     String?   @map("property_id")
  contactId      String?   @map("contact_id")
  title          String
  status         String    @default("open")
  priority       String    @default("normal")
  notes          String?
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  property     PmProperty?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, propertyId])
  @@map("pm_maintenance_requests")
}

// ─── AI Communications (provider-agnostic orchestration) ───────────────────

model CommunicationAgent {
  id               String    @id @default(cuid())
  organisationId   String    @map("organisation_id")
  name             String
  description      String?
  /** receptionist | sales | support | booking | qualification | follow_up | custom */
  type             String    @default("custom")
  /** draft | published | disabled */
  status           String    @default("draft")
  provider         String    @default("elevenlabs")
  providerAgentId  String?   @map("provider_agent_id")
  voiceId          String?   @map("voice_id")
  model            String?
  systemPrompt     String?   @map("system_prompt") @db.Text
  greeting         String?
  language         String    @default("en-AU")
  timezone         String    @default("Australia/Brisbane")
  businessHours    Json?     @map("business_hours")
  enabledChannels  Json?     @map("enabled_channels")
  knowledgeBaseId  String?   @map("knowledge_base_id")
  routingRules     Json?     @map("routing_rules")
  transferRules    Json?     @map("transfer_rules")
  escalationRules  Json?     @map("escalation_rules")
  /** Structured Agent Builder config (identity, purpose, behaviour, tools, compliance) */
  config           Json?
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sessions     CommunicationSession[]

  @@index([organisationId, status])
  @@index([organisationId, provider])
  @@index([providerAgentId])
  @@map("communication_agents")
}

model CommunicationSession {
  id                 String    @id @default(cuid())
  organisationId     String    @map("organisation_id")
  agentId            String?   @map("agent_id")
  contactId          String?   @map("contact_id")
  companyId          String?   @map("company_id")
  opportunityId      String?   @map("opportunity_id")
  /** voice | sms | email | chat | whatsapp */
  channel            String    @default("voice")
  /** inbound | outbound */
  direction          String    @default("inbound")
  provider           String    @default("elevenlabs")
  providerSessionId  String?   @map("provider_session_id")
  /** ringing | in_progress | completed | missed | failed | transferred */
  status             String    @default("in_progress")
  startedAt          DateTime? @map("started_at")
  endedAt            DateTime? @map("ended_at")
  durationSeconds    Int?      @map("duration_seconds")
  transcript         String?   @db.Text
  summary            String?   @db.Text
  sentiment          String?
  outcome            String?
  recordingUrl       String?   @map("recording_url")
  costCents          Int?      @map("cost_cents")
  usageUnits         Decimal?  @map("usage_units") @db.Decimal(12, 4)
  callerPhone        String?   @map("caller_phone")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agent        CommunicationAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages     CommunicationMessage[]
  actions      AgentAction[]

  @@unique([organisationId, provider, providerSessionId])
  @@index([organisationId, startedAt])
  @@index([organisationId, status])
  @@index([organisationId, contactId])
  @@index([agentId])
  @@map("communication_sessions")
}

model CommunicationMessage {
  id                 String   @id @default(cuid())
  organisationId     String   @map("organisation_id")
  sessionId          String   @map("session_id")
  sender             String
  recipient          String?
  direction          String
  channel            String   @default("voice")
  content            String   @db.Text
  timestamp          DateTime @default(now())
  providerMessageId  String?  @map("provider_message_id")
  status             String   @default("delivered")
  metadata           Json?

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([organisationId])
  @@map("communication_messages")
}

model AgentAction {
  id              String   @id @default(cuid())
  organisationId  String   @map("organisation_id")
  sessionId       String?  @map("session_id")
  agentId         String?  @map("agent_id")
  tool            String
  status          String   @default("ok")
  input           Json?
  output          Json?
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  error           String?
  actorType       String   @default("agent") @map("actor_type")
  createdAt       DateTime @default(now()) @map("created_at")

  session CommunicationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([sessionId])
  @@map("agent_actions")
}

model CommunicationUsage {
  id              String   @id @default(cuid())
  organisationId  String   @map("organisation_id")
  agentId         String?  @map("agent_id")
  sessionId       String?  @map("session_id")
  provider        String
  metric          String
  units           Decimal  @db.Decimal(12, 4)
  providerCostCents Int?   @map("provider_cost_cents")
  platformFeeCents  Int?   @map("platform_fee_cents")
  occurredAt      DateTime @default(now()) @map("occurred_at")
  metadata        Json?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([organisationId, provider])
  @@map("communication_usages")
}

model SupportConversation {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique @map("clerk_user_id")
  organisationId String?  @map("organisation_id")
  contactId      String?  @map("contact_id")
  status         String   @default("open")
  aiPaused       Boolean  @default(false) @map("ai_paused")
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages SupportMessage[]

  @@index([lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id                Int      @id @default(autoincrement())
  conversationId    String   @map("conversation_id")
  senderRole        String   @map("sender_role")
  senderClerkUserId String?  @map("sender_clerk_user_id")
  body              String   @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("support_messages")
}
