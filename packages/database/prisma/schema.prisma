// DigitalGate Platform — Universal Objects (Platform 1.0)
// See docs/foundations/CORE-OBJECT-SPECIFICATION.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id              String   @id @default(cuid())
  clerkOrgId      String?  @unique @map("clerk_org_id")
  name            String
  slug            String   @unique
  locale          String   @default("en-AU")
  timezone        String   @default("Australia/Brisbane") @map("timezone")
  currency        String   @default("AUD")
  status          String   @default("trial")
  settings        Json?
  billingCustomerId String? @map("billing_customer_id")
  industry        String?
  /** Share slug for Platform Refer & Earn — /r/{referralCode} */
  referralCode    String?  @unique @map("referral_code")
  /** Organisation that referred this tenant (single-level only — no MLM) */
  referredByOrganisationId String? @map("referred_by_organisation_id")
  /** Stripe Connect Express account for Refer & Earn cash payouts */
  stripeConnectAccountId String? @map("stripe_connect_account_id")
  /**
   * Connect onboarding: not_started | pending | restricted | complete | disabled
   * Synced from account.updated webhooks / onboarding return.
   */
  stripeConnectStatus String? @map("stripe_connect_status")
  stripeConnectPayoutsEnabled Boolean @default(false) @map("stripe_connect_payouts_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  contacts         Contact[]
  companies        Company[]
  activities       Activity[]
  tasks            Task[]
  notifications    Notification[]
  leads            Lead[]
  opportunities    Opportunity[]
  properties       Property[]
  appInstallations AppInstallation[]
  auditLogs        AuditLog[]

  commerceProducts           CommerceProduct[]
  commerceQuotes             CommerceQuote[]
  commerceInvoices           CommerceInvoice[]
  commercePaymentRequests    CommercePaymentRequest[]
  commercePayments           CommercePayment[]
  commerceSubscriptions      CommerceSubscription[]
  commerceRefunds            CommerceRefund[]
  paymentConnectorInstallations PaymentConnectorInstallation[]
  convertedGrowthProspects      GrowthProspect[] @relation("ConvertedProspect")
  platformApiKeys               PlatformApiKey[]
  stayBookings                  StayBooking[]
  accommodationGuestProfiles    AccommodationGuestProfile[]
  accommodationUnits            AccommodationUnit[]
  websites                      Website[]
  infrastructureDomains         InfrastructureDomain[]
  dreamscapeCustomerLink        DreamscapeCustomerLink?

  referredBy        Organisation?  @relation("OrgReferral", fields: [referredByOrganisationId], references: [id], onDelete: SetNull)
  referralsMade     Organisation[] @relation("OrgReferral")
  platformReferralsAsReferrer PlatformReferral[] @relation("ReferralReferrer")
  platformReferralsAsReferred PlatformReferral[] @relation("ReferralReferred")
  referralLedgerEntries       PlatformReferralLedger[]

  @@index([stripeConnectAccountId])
  @@map("organisations")
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  clerkUserId    String   @map("clerk_user_id")
  role           String   @default("member")
  status         String   @default("active")
  /** Login / account email cached from Clerk (not the public profile address). */
  email          String?
  /**
   * Public-facing email on this org's team / agent card.
   * Per-organisation — may differ from login `email` (e.g. sales@agency vs personal login).
   */
  publicEmail    String?  @map("public_email")
  displayName    String?  @map("display_name")
  /** Public-facing bio / about — used for agent profiles and team pages */
  bio            String?  @db.Text
  jobTitle       String?  @map("job_title")
  phone          String?
  /** Profile / agent photo URL (Clerk default or uploaded override) */
  avatarUrl      String?  @map("avatar_url")
  /** WordPress agent post ID when synced */
  externalRefs   Json?    @map("external_refs")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, clerkUserId])
  @@index([clerkUserId])
  @@map("memberships")
}

model Contact {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  email          String?
  phone          String?
  status         String    @default("active")
  source         String?
  tags           String?
  companyId      String?   @map("company_id")
  assignedUserId String?   @map("assigned_user_id")
  legacyWpId     Int?      @map("legacy_wp_id")
  metadata       Json?
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  stayBookings  StayBooking[]
  accommodationGuestProfile AccommodationGuestProfile?

  @@index([organisationId, email])
  @@index([organisationId, status])
  @@map("contacts")
}

model Company {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String
  website        String?
  phone          String?
  email          String?
  industry       String?
  metadata       Json?
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@index([organisationId])
  @@map("companies")
}

model Activity {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  activityType   String   @map("activity_type")
  title          String
  body           String?
  metadata       Json?
  sourceApp      String?  @map("source_app")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
  @@map("activities")
}

model Task {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  title          String
  description    String?
  status         String    @default("open")
  assignedUserId String?   @map("assigned_user_id")
  dueAt          DateTime? @map("due_at")
  completedAt    DateTime? @map("completed_at")
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id")
  priority       String?
  sourceApp      String?   @map("source_app")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@map("tasks")
}

/** In-app notifications — fan-out from platform event bus (not push/OS yet). */
model Notification {
  id               String    @id @default(cuid())
  organisationId   String    @map("organisation_id")
  /** Null = org-wide; otherwise Clerk user id */
  recipientUserId  String?   @map("recipient_user_id")
  type             String
  title            String
  body             String?
  href             String?
  entityType       String?   @map("entity_type")
  entityId         String?   @map("entity_id")
  readAt           DateTime? @map("read_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([organisationId, readAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model Lead {
  id              String    @id @default(cuid())
  organisationId  String    @map("organisation_id")
  status          String    @default("new")
  source          String
  title           String?
  description     String?
  contactId       String?   @map("contact_id")
  assignedUserId  String?   @map("assigned_user_id")
  channel         String?
  campaignId      String?   @map("campaign_id")
  responseDueAt   DateTime? @map("response_due_at")
  firstResponseAt DateTime? @map("first_response_at")
  metadata        Json?
  externalRefs    Json?     @map("external_refs")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?

  @@index([organisationId, status])
  @@index([organisationId, contactId])
  @@map("leads")
}

/** Qualified pipeline item — CRM base; RE / industry apps own stage definitions. */
model Opportunity {
  id               String    @id @default(cuid())
  organisationId   String    @map("organisation_id")
  title            String
  stage            String
  status           String    @default("open")
  contactId        String?   @map("contact_id")
  companyId        String?   @map("company_id")
  leadId           String?   @unique @map("lead_id")
  propertyId       String?   @map("property_id")
  assignedUserId   String?   @map("assigned_user_id")
  valueCents       Int?      @map("value_cents")
  currency         String    @default("AUD")
  probability      Int?
  expectedCloseDate DateTime? @map("expected_close_date")
  lostReason       String?   @map("lost_reason")
  pipelineId       String?   @map("pipeline_id")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, stage])
  @@map("opportunities")
}

model Property {
  id                String    @id @default(cuid())
  organisationId    String    @map("organisation_id")
  addressLine1        String    @map("address_line1")
  addressLine2        String?   @map("address_line2")
  suburb              String
  state               String
  postcode            String
  country             String    @default("AU")
  status              String    @default("prospect")
  propertyType        String?   @map("property_type")
  bedrooms            Int?
  bathrooms           Int?
  ownerContactId      String?   @map("owner_contact_id")
  leadId              String?   @map("lead_id")
  listingPriceCents   Int?      @map("listing_price_cents")
  currency            String    @default("AUD")
  metadata            Json?
  externalRefs        Json?     @map("external_refs")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([organisationId, leadId])
  @@map("properties")
}

/**
 * Hospitality unit / property (WP dg_accommodation mirror → Gen 2 SoT when synced).
 * Housekeeping status + manual blocks live here; availability is derived with StayBooking.
 */
model AccommodationUnit {
  id                   String    @id @default(cuid())
  organisationId       String    @map("organisation_id")
  /** WordPress dg_accommodation post ID when mirrored */
  externalWpId         Int?      @map("external_wp_id")
  title                String
  slug                 String?
  postStatus           String?   @map("post_status")
  listingStatus        String    @default("bookable") @map("listing_status")
  description          String?   @db.Text
  accommodationType    String?   @map("accommodation_type")
  address              String?
  weekdayRateCents     Int?      @map("weekday_rate_cents")
  weekendRateCents     Int?      @map("weekend_rate_cents")
  cleaningFeeCents     Int?      @map("cleaning_fee_cents")
  sleeps               Int?
  bedrooms             Int?
  bathrooms            Float?
  maxGuests            Int?      @map("max_guests")
  minNights            Int?      @map("min_nights")
  checkinTime          String?   @map("checkin_time")
  checkoutTime         String?   @map("checkout_time")
  features             Json?
  featuredImageUrl     String?   @map("featured_image_url")
  galleryUrls          Json?     @map("gallery_urls")
  airbnbIcalUrl        String?   @map("airbnb_ical_url")
  bookingcomIcalUrl    String?   @map("bookingcom_ical_url")
  icalExportUrl        String?   @map("ical_export_url")
  housekeepingStatus   String    @default("unknown") @map("housekeeping_status")
  housekeepingNotes    String?   @map("housekeeping_notes") @db.Text
  lastCleaned          DateTime? @map("last_cleaned")
  /** Operator manual blocks only (YYYY-MM-DD[]) */
  manualBlockedDates   Json?     @map("manual_blocked_dates")
  checkinUrl           String?   @map("checkin_url")
  cleaningFormUrl      String?   @map("cleaning_form_url")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stayBookings StayBooking[]

  @@unique([organisationId, externalWpId])
  @@index([organisationId, listingStatus])
  @@index([organisationId, housekeepingStatus])
  @@map("accommodation_units")
}

/** Hospitality stay booking — Gen 2 read SoT; externalWpId null until WP mirror (Gen 2-first). */
model StayBooking {
  id                 String    @id @default(cuid())
  organisationId     String    @map("organisation_id")
  /** WordPress dg_booking post ID when mirrored; null for Gen 2-native creates */
  externalWpId       Int?      @map("external_wp_id")
  ref                String?
  /** Universal Contact — guest is never a separate people object */
  contactId          String?   @map("contact_id")
  guestName          String    @map("guest_name")
  email              String?
  phone              String?
  accommodationName  String?   @map("accommodation_name")
  accommodationWpId  Int?      @map("accommodation_wp_id")
  accommodationUnitId String?  @map("accommodation_unit_id")
  checkin            DateTime?
  checkout           DateTime?
  status             String    @default("pending")
  totalCents         Int?      @map("total_cents")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact            Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accommodationUnit  AccommodationUnit? @relation(fields: [accommodationUnitId], references: [id], onDelete: SetNull)

  @@unique([organisationId, externalWpId])
  @@index([organisationId, status])
  @@index([organisationId, checkin])
  @@index([organisationId, contactId])
  @@index([organisationId, accommodationUnitId])
  @@map("stay_bookings")
}

/**
 * Accommodation app context on a Contact — NOT a Universal Object / people type.
 * Preferences and VIP flags live here; identity stays on Contact.
 * @see docs/foundations/CONTACTS-AND-APP-ROLES.md
 */
model AccommodationGuestProfile {
  id                 String    @id @default(cuid())
  organisationId     String    @map("organisation_id")
  /** One guest profile per Contact (Contact ids are globally unique) */
  contactId          String    @unique @map("contact_id")
  /** WordPress guest / customer id when mirrored from connector */
  legacyWpGuestId    Int?      @map("legacy_wp_guest_id")
  vip                Boolean   @default(false)
  marketingConsent   Boolean?  @map("marketing_consent")
  favouriteUnit      String?   @map("favourite_unit")
  preferences        String?   @db.Text
  specialRequests    String?   @map("special_requests") @db.Text
  guestNotes         String?   @map("guest_notes") @db.Text
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organisationId, legacyWpGuestId])
  @@index([organisationId])
  @@map("accommodation_guest_profiles")
}

model AppInstallation {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  appId          String   @map("app_id")
  version        String   @default("1.0.0")
  enabled        Boolean  @default(true)
  settings       Json?
  installedAt    DateTime @default(now()) @map("installed_at")
  installedBy    String?  @map("installed_by")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, appId])
  @@map("app_installations")
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  actorId        String?  @map("actor_id")
  actorType      String   @default("user") @map("actor_type")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  changes        Json?
  ipAddress      String?  @map("ip_address")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// ─── Growth Engine (Command Centre — internal acquisition) ─────────────────

model GrowthProspect {
  id                      String    @id @default(cuid())
  businessName            String    @map("business_name")
  contactName             String?   @map("contact_name")
  contactEmail            String?   @map("contact_email")
  contactPhone            String?   @map("contact_phone")
  industry                String?
  location                String?
  websiteUrl              String?   @map("website_url")
  stage                   String    @default("prospect")
  ownerClerkUserId        String?   @map("owner_clerk_user_id")
  convertedOrganisationId String?   @map("converted_organisation_id")
  metadata                Json?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  convertedOrganisation Organisation?            @relation("ConvertedProspect", fields: [convertedOrganisationId], references: [id], onDelete: SetNull)
  audits                GrowthProspectAudit[]
  reports               GrowthProspectReport[]
  engagements           GrowthProspectEngagement[]

  @@index([stage])
  @@index([ownerClerkUserId])
  @@map("growth_prospects")
}

model GrowthProspectAudit {
  id              String   @id @default(cuid())
  prospectId      String   @map("prospect_id")
  businessHealth  Int?     @map("business_health")
  aiVisibility    Int?     @map("ai_visibility")
  seoScore        Int?     @map("seo_score")
  websiteHealth   Int?     @map("website_health")
  findings        Json?
  auditVersion    String   @default("1.0") @map("audit_version")
  auditedAt       DateTime @default(now()) @map("audited_at")

  prospect GrowthProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@map("growth_prospect_audits")
}

model GrowthProspectReport {
  id              String    @id @default(cuid())
  prospectId      String    @map("prospect_id")
  auditId         String?   @map("audit_id")
  shareToken      String    @unique @map("share_token")
  executiveSummary String?  @map("executive_summary")
  viewCount       Int       @default(0) @map("view_count")
  sentAt          DateTime? @map("sent_at")
  firstViewedAt   DateTime? @map("first_viewed_at")
  generatedAt     DateTime  @default(now()) @map("generated_at")

  prospect GrowthProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@map("growth_prospect_reports")
}

model GrowthProspectEngagement {
  id         String   @id @default(cuid())
  prospectId String   @map("prospect_id")
  reportId   String?  @map("report_id")
  type       String
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  prospect GrowthProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, type])
  @@map("growth_prospect_engagements")
}

// ─── Commerce (customer-facing commercial layer) ───────────────────────────

model CommerceProduct {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String
  description    String?
  sku            String?
  unitAmountCents Int      @map("unit_amount_cents")
  currency       String    @default("AUD")
  taxCode        String?   @map("tax_code")
  taxRateBps     Int?      @map("tax_rate_bps")
  active         Boolean   @default(true)
  metadata       Json?
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, active])
  @@map("commerce_products")
}

model CommerceQuote {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  contactId      String?   @map("contact_id")
  quoteNumber    String?   @map("quote_number")
  status         String    @default("draft")
  sourceApp      String?   @map("source_app")
  sourceEntityType String? @map("source_entity_type")
  sourceEntityId String?   @map("source_entity_id")
  currency       String    @default("AUD")
  subtotalCents  Int       @map("subtotal_cents")
  taxCents       Int       @default(0) @map("tax_cents")
  totalCents     Int       @map("total_cents")
  validUntil     DateTime? @map("valid_until")
  acceptedAt     DateTime? @map("accepted_at")
  notes          String?
  lineItems      Json      @map("line_items")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoices     CommerceInvoice[]

  @@index([organisationId, status])
  @@map("commerce_quotes")
}

model CommerceInvoice {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  contactId      String?   @map("contact_id")
  quoteId        String?   @map("quote_id")
  invoiceNumber  String?   @map("invoice_number")
  status         String    @default("draft")
  sourceApp      String?   @map("source_app")
  sourceEntityType String? @map("source_entity_type")
  sourceEntityId String?   @map("source_entity_id")
  currency       String    @default("AUD")
  subtotalCents  Int       @map("subtotal_cents")
  taxCents       Int       @default(0) @map("tax_cents")
  totalCents     Int       @map("total_cents")
  dueAt          DateTime? @map("due_at")
  paidAt         DateTime? @map("paid_at")
  notes          String?
  lineItems      Json      @map("line_items")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  quote           CommerceQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  paymentRequests CommercePaymentRequest[]

  @@index([organisationId, status])
  @@index([organisationId, dueAt])
  @@map("commerce_invoices")
}

model CommercePaymentRequest {
  id                String    @id @default(cuid())
  organisationId    String    @map("organisation_id")
  contactId         String?   @map("contact_id")
  quoteId           String?   @map("quote_id")
  invoiceId         String?   @map("invoice_id")
  sourceApp         String    @map("source_app")
  sourceEntityType  String?   @map("source_entity_type")
  sourceEntityId    String?   @map("source_entity_id")
  status            String    @default("pending")
  currency          String    @default("AUD")
  subtotalCents     Int       @map("subtotal_cents")
  totalCents        Int       @map("total_cents")
  allowedMethods    Json?     @map("allowed_methods")
  providerId        String?   @map("provider_id")
  providerSessionId String?   @map("provider_session_id")
  checkoutUrl       String?   @map("checkout_url")
  paymentLinkUrl    String?   @map("payment_link_url")
  description       String?
  dueAt             DateTime? @map("due_at")
  paidAt            DateTime? @map("paid_at")
  expiresAt         DateTime? @map("expires_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice      CommerceInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payments     CommercePayment[]

  @@index([organisationId, status])
  @@index([organisationId, sourceApp])
  @@map("commerce_payment_requests")
}

model CommercePayment {
  id                String    @id @default(cuid())
  organisationId    String    @map("organisation_id")
  paymentRequestId  String    @map("payment_request_id")
  contactId         String?   @map("contact_id")
  providerId        String    @map("provider_id")
  providerPaymentId String    @map("provider_payment_id")
  status            String    @default("pending")
  amountCents       Int       @map("amount_cents")
  currency          String    @default("AUD")
  paymentMethod     String?   @map("payment_method")
  paidAt            DateTime? @map("paid_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  paymentRequest CommercePaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  refunds        CommerceRefund[]

  @@unique([organisationId, providerPaymentId])
  @@index([organisationId, paidAt])
  @@map("commerce_payments")
}

model CommerceSubscription {
  id                   String    @id @default(cuid())
  organisationId       String    @map("organisation_id")
  contactId            String?   @map("contact_id")
  providerId           String    @map("provider_id")
  providerSubscriptionId String  @map("provider_subscription_id")
  status               String    @default("active")
  currency             String    @default("AUD")
  amountCents          Int       @map("amount_cents")
  interval             String    @default("month")
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelledAt          DateTime? @map("cancelled_at")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerSubscriptionId])
  @@index([organisationId, status])
  @@map("commerce_subscriptions")
}

model CommerceRefund {
  id               String   @id @default(cuid())
  organisationId   String   @map("organisation_id")
  paymentId        String   @map("payment_id")
  providerId       String   @map("provider_id")
  providerRefundId String   @map("provider_refund_id")
  status           String   @default("pending")
  amountCents      Int      @map("amount_cents")
  currency         String   @default("AUD")
  reason           String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payment      CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerRefundId])
  @@map("commerce_refunds")
}

model PaymentConnectorInstallation {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  providerId     String   @map("provider_id")
  status         String   @default("pending")
  accountId      String?  @map("account_id")
  credentialRef  String?  @map("credential_ref")
  enabledMethods Json?    @map("enabled_methods")
  settings       Json?
  connectedAt    DateTime? @map("connected_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerId])
  @@map("payment_connector_installations")
}

model PlatformApiKey {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @map("key_hash")
  scopes         Json?
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([keyHash])
  @@map("platform_api_keys")
}

// ─── Platform Refer & Earn (SaaS acquisition — not B2B Network referrals) ───

/**
 * Single-level only: referrer Organisation → referred Organisation.
 * Lifecycle: invited → signed_up → trial → paid → rewarded (or churned).
 * See docs/foundations/REVIEWS-AND-REFERRALS.md §A.
 */
model PlatformReferral {
  id                     String    @id @default(cuid())
  referrerOrganisationId String    @map("referrer_organisation_id")
  referredOrganisationId String?   @unique @map("referred_organisation_id")
  code                   String
  /** invited | signed_up | trial | paid | rewarded | churned */
  status                 String    @default("invited")
  inviteEmail            String?   @map("invite_email")
  inviteName             String?   @map("invite_name")
  /** Months of reward remaining (starts at 12 on first paid) */
  rewardMonthsRemaining  Int       @default(12) @map("reward_months_remaining")
  /** Customer 20% default; partner rates set later */
  commissionBps          Int       @default(2000) @map("commission_bps")
  firstPaidAt            DateTime? @map("first_paid_at")
  rewardedUntil          DateTime? @map("rewarded_until")
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  referrer Organisation              @relation("ReferralReferrer", fields: [referrerOrganisationId], references: [id], onDelete: Cascade)
  referred Organisation?             @relation("ReferralReferred", fields: [referredOrganisationId], references: [id], onDelete: SetNull)
  ledger   PlatformReferralLedger[]

  @@index([referrerOrganisationId, status])
  @@index([code])
  @@index([inviteEmail])
  @@map("platform_referrals")
}

model PlatformReferralLedger {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  referralId     String   @map("referral_id")
  /** credit | cash_payout | cash_payout_stub | cash_payout_reversal | reversal */
  entryType      String   @map("entry_type")
  amountCents    Int      @map("amount_cents")
  currency       String   @default("AUD")
  description    String?
  /** Stripe invoice / subscription period id when available */
  stripeRef      String?  @map("stripe_ref")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  referral     PlatformReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([referralId])
  @@map("platform_referral_ledger")
}

// ─── Website Builder (first-class Org → Business Profile → Websites) ───
// Structured page/component model — not raw HTML. See docs/foundations/WEBSITE-BUILDER.md

model Website {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String
  /** Public path slug — unique globally for /sites/[slug] */
  slug           String    @unique
  /** draft | published | archived */
  status         String    @default("draft")
  brief          String?   @db.Text
  /** Brand tokens (primary, accent, logo, fonts) derived from Business Profile */
  theme          Json?
  seo            Json?
  /** Domains / hosting stubs, WP import markers, industry hooks */
  metadata       Json?
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  pages        WebsitePage[]
  domains      InfrastructureDomain[]

  @@index([organisationId, status])
  @@map("websites")
}

/**
 * Org-owned domain inventory (DigitalGate Domains).
 * Provider brand stays internal — UX never says “Dreamscape”.
 */
model InfrastructureDomain {
  id                   String    @id @default(cuid())
  organisationId       String    @map("organisation_id")
  /** FQDN lowercase, e.g. example.com.au */
  name                 String
  /**
   * registered | pending | connected | transferring | expired | error | unknown
   */
  status               String    @default("unknown")
  /**
   * registered (bought via DG) | connected (bring-your-own) | transferred
   */
  source               String    @default("connected")
  providerId           String    @default("dreamscape") @map("provider_id")
  /** Provider domain id when known (REST) */
  providerDomainId     String?   @map("provider_domain_id")
  /** SOAP contact id or REST customer id used at registration */
  providerCustomerId   String?   @map("provider_customer_id")
  websiteId            String?   @map("website_id")
  /** When true, DigitalGate manages DNS / go-live for this domain */
  managed              Boolean   @default(true)
  autoRenew            Boolean?  @map("auto_renew")
  expiresAt            DateTime? @map("expires_at")
  nameservers          Json?
  /** Desired / last-applied DNS records snapshot */
  dnsRecords           Json?     @map("dns_records")
  dnsConfiguredAt      DateTime? @map("dns_configured_at")
  /** unknown | pending | active | missing */
  sslState             String    @default("unknown") @map("ssl_state")
  eligibility          Json?
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  website      Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@unique([organisationId, name])
  @@index([name])
  @@index([organisationId, status])
  @@index([websiteId])
  @@map("infrastructure_domains")
}

/** Durable Org ↔ Dreamscape customer / SOAP contact mapping */
model DreamscapeCustomerLink {
  id                     String   @id @default(cuid())
  organisationId         String   @unique @map("organisation_id")
  /** REST customer id when available */
  dreamscapeCustomerId   String?  @map("dreamscape_customer_id")
  /** SOAP ContactIdentifier used for DomainCreate */
  contactIdentifier      String?  @map("contact_identifier")
  customerName           String?  @map("customer_name")
  linkedAt               DateTime @default(now()) @map("linked_at")
  metadata               Json?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([dreamscapeCustomerId])
  @@index([contactIdentifier])
  @@map("dreamscape_customer_links")
}

model WebsitePage {
  id         String   @id @default(cuid())
  websiteId  String   @map("website_id")
  title      String
  slug       String
  /** home | about | services | contact | custom */
  intent     String?
  /** draft | published */
  status     String   @default("draft")
  sortOrder  Int      @default(0) @map("sort_order")
  seo        Json?
  /**
   * Typed component tree — source of truth for Studio + renderer.
   * Array of { id, type, props } — never raw HTML dumps.
   */
  components Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId, sortOrder])
  @@map("website_pages")
}
